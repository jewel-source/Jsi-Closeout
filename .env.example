# --- Seafile (source of the closeout Excel sheets) ---
SEAFILE_SERVER_URL=https://seafile.jsi.studio
SEAFILE_REPO_ID=0a78bbec-cd02-472f-9af6-9987cb0ec8af
SEAFILE_FOLDER_PATH=/JEWEL_SOURCE_JEWELLRY/CUSTOMERS/CLOSEOUTS 1/2026/CLOSEOUT- MASTER FILES

# Either provide a token directly...
SEAFILE_API_TOKEN=
# ...or a username/password, and the import script will fetch a token.
SEAFILE_USERNAME=
SEAFILE_PASSWORD=

# --- Photos (photos.jsi.studio, an Immich server) ---
# The import script searches Immich by filename (matching the style number)
# at import time; the live site then fetches the actual image bytes on
# demand through /api/immich-image, which also needs these two vars set in
# whatever environment runs the app (not just here) — see README. The key is
# used server-side only and is NEVER sent to the browser. Do not add a
# NEXT_PUBLIC_ prefix to it; an Immich key can read your whole photo library.
IMMICH_BASE_URL=https://photos.jsi.studio/api
IMMICH_API_KEY=
# "preview" (good quality, reasonable file size) or "thumbnail" (smaller).
IMMICH_THUMBNAIL_SIZE=preview
MAX_PHOTOS_PER_ITEM=6
# A style's photo match is cached from the previous catalog.json, so only
# new/unmatched styles hit Immich on each run. Set to "true" to ignore the
# cache and re-search every style (e.g. after reorganizing photos in Immich).
FORCE_PHOTO_REFRESH=false

# --- Quote request form (Web3Forms: https://web3forms.com) ---
# Create a free access key at web3forms.com using info@jewelsource.inc,
# then paste the key here. Exposed to the browser by design (public key model).
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
